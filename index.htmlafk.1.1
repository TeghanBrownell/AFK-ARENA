<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>AFK-BOT — Farm Units, Battle-Chips & Gold</title>
<meta name="description" content="AFK-BOT: the ultimate arena bot. Farm Units, Battle-Chips, and Gold — 24/7, hands-free." />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bangers&family=Bungee&family=Permanent+Marker&family=Inter:wght@400;600;800&display=swap" rel="stylesheet">
<style>
  /* ============================================
     CONFIG — Lemon Squeezy checkout overlay.
     Buy buttons use class="lemonsqueezy-button" + the
     product checkout URL. The lemon.js script at the
     bottom of <body> intercepts clicks and opens the
     overlay automatically. Update prices in the
     pricing cards below to match your LS products.
     ============================================ */
  :root {
    --yellow: #FFE500;
    --red: #FF2A2A;
    --blue: #1EA7FF;
    --pink: #FF3DB4;
    --ink: #0A0A0A;
    --paper: #FFF6DC;
    --paper-2: #FFEDAB;
    --border-w: 4px;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; }
  body {
    font-family: 'Inter', system-ui, sans-serif;
    background: var(--paper);
    color: var(--ink);
    overflow-x: hidden;
    line-height: 1.5;
  }
  /* Halftone overlay for a subtle comic texture */
  body::before {
    content: "";
    position: fixed;
    inset: 0;
    background-image: radial-gradient(rgba(10,10,10,0.08) 1px, transparent 1.4px);
    background-size: 8px 8px;
    pointer-events: none;
    z-index: 0;
  }
  main, nav, footer { position: relative; z-index: 1; }
  /* ============================================
     NAV
     ============================================ */
  nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--ink);
    border-bottom: var(--border-w) solid var(--ink);
    box-shadow: 0 4px 0 var(--yellow);
  }
  .nav-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 14px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .logo {
    font-family: 'Bangers', 'Bungee', sans-serif;
    font-size: 34px;
    letter-spacing: 2px;
    color: var(--yellow);
    text-shadow: 2px 2px 0 var(--red);
    user-select: none;
  }
  .nav-links { display: flex; gap: 22px; align-items: center; }
  .nav-links a {
    color: #fff;
    text-decoration: none;
    font-weight: 800;
    font-size: 14px;
    letter-spacing: 1px;
    text-transform: uppercase;
  }
  .nav-links a:hover { color: var(--yellow); }
  .nav-cta {
    background: var(--red);
    color: #fff !important;
    padding: 8px 14px;
    border: 3px solid var(--ink);
    box-shadow: 3px 3px 0 var(--yellow);
    transition: transform .1s;
  }
  .nav-cta:hover { transform: translate(-2px,-2px); box-shadow: 5px 5px 0 var(--yellow); color: #fff !important; }
  @media (max-width: 600px) {
    .nav-links a:not(.nav-cta) { display: none; }
    .logo { font-size: 26px; }
  }
  /* ============================================
     HERO
     ============================================ */
  .hero {
    position: relative;
    min-height: 90vh;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    border-bottom: var(--border-w) solid var(--ink);
  }
  .hero video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }
  .hero::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at center, rgba(0,0,0,0.2), rgba(0,0,0,0.75)),
      radial-gradient(rgba(255,255,255,0.06) 1px, transparent 1.2px) 0 0 / 6px 6px;
    z-index: 1;
  }
  .hero-inner {
    position: relative;
    z-index: 2;
    padding: 80px 24px;
    max-width: 1000px;
  }
  .hero h1 {
    font-family: 'Bangers', sans-serif;
    font-size: clamp(56px, 12vw, 160px);
    line-height: .9;
    letter-spacing: 3px;
    color: var(--yellow);
    -webkit-text-stroke: 3px var(--ink);
    text-shadow:
      5px 5px 0 var(--red),
      10px 10px 0 var(--ink);
    transform: rotate(-2deg);
    margin-bottom: 18px;
  }
  .hero .tag {
    display: inline-block;
    background: var(--yellow);
    color: var(--ink);
    padding: 10px 20px;
    border: 3px solid var(--ink);
    box-shadow: 5px 5px 0 var(--ink);
    font-family: 'Bangers', sans-serif;
    font-size: clamp(18px, 2.2vw, 28px);
    letter-spacing: 2px;
    transform: rotate(1deg);
    margin-bottom: 28px;
  }
  .hero p.sub {
    color: #fff;
    font-size: clamp(15px, 1.6vw, 20px);
    max-width: 620px;
    margin: 0 auto 32px;
    font-weight: 600;
    text-shadow: 0 2px 6px rgba(0,0,0,0.8);
  }
  .btn-big {
    display: inline-block;
    background: var(--red);
    color: #fff;
    font-family: 'Bangers', sans-serif;
    font-size: 32px;
    letter-spacing: 3px;
    padding: 16px 36px;
    border: 4px solid var(--ink);
    box-shadow: 6px 6px 0 var(--yellow);
    text-decoration: none;
    transform: rotate(-1deg);
    transition: transform .1s, box-shadow .1s;
  }
  .btn-big:hover {
    transform: rotate(-1deg) translate(-3px,-3px);
    box-shadow: 9px 9px 0 var(--yellow);
  }
  .scroll-hint {
    position: absolute;
    bottom: 18px;
    left: 50%;
    transform: translateX(-50%);
    color: #fff;
    font-family: 'Bangers', sans-serif;
    letter-spacing: 2px;
    font-size: 18px;
    z-index: 2;
    opacity: .85;
    animation: bounce 1.6s infinite;
  }
  @keyframes bounce {
    0%, 100% { transform: translate(-50%, 0); }
    50% { transform: translate(-50%, 8px); }
  }
  /* ============================================
     SECTIONS
     ============================================ */
  section {
    padding: 90px 24px;
    border-bottom: var(--border-w) solid var(--ink);
    position: relative;
  }
  .container {
    max-width: 1200px;
    margin: 0 auto;
  }
  .section-title {
    font-family: 'Bangers', sans-serif;
    font-size: clamp(44px, 7vw, 88px);
    letter-spacing: 2px;
    color: var(--ink);
    text-align: center;
    transform: rotate(-1deg);
    margin-bottom: 14px;
    text-shadow: 4px 4px 0 var(--yellow);
  }
  .section-sub {
    text-align: center;
    font-weight: 700;
    font-size: 16px;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--ink);
    margin-bottom: 54px;
  }
  /* ============================================
     FEATURES — comic panels
     ============================================ */
  #features { background: var(--paper-2); }
  .panels {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 28px;
  }
  .panel {
    background: #fff;
    border: var(--border-w) solid var(--ink);
    box-shadow: 8px 8px 0 var(--ink);
    padding: 30px 24px 28px;
    position: relative;
    transition: transform .15s, box-shadow .15s;
  }
  .panel:nth-child(1) { transform: rotate(-1deg); }
  .panel:nth-child(2) { transform: rotate(1deg); }
  .panel:nth-child(3) { transform: rotate(-1.5deg); }
  .panel:nth-child(1):hover { transform: rotate(-1deg) translate(-3px, -3px); box-shadow: 11px 11px 0 var(--ink); }
  .panel:nth-child(2):hover { transform: rotate(1deg) translate(-3px, -3px); box-shadow: 11px 11px 0 var(--ink); }
  .panel:nth-child(3):hover { transform: rotate(-1.5deg) translate(-3px, -3px); box-shadow: 11px 11px 0 var(--ink); }
  .sfx {
    position: absolute;
    top: -22px;
    right: -14px;
    background: var(--yellow);
    border: 3px solid var(--ink);
    font-family: 'Bangers', sans-serif;
    font-size: 22px;
    letter-spacing: 1px;
    padding: 6px 12px;
    transform: rotate(8deg);
    box-shadow: 3px 3px 0 var(--ink);
  }
  .panel:nth-child(2) .sfx { background: var(--red); color: #fff; transform: rotate(-6deg); }
  .panel:nth-child(3) .sfx { background: var(--blue); color: #fff; transform: rotate(10deg); }
  .panel-icon {
    width: 120px;
    height: 120px;
    margin: 0 auto 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--paper);
    border: 3px solid var(--ink);
    box-shadow: 4px 4px 0 var(--ink);
    overflow: hidden;
  }
  .panel-icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    filter: drop-shadow(2px 2px 0 rgba(0,0,0,0.2));
  }
  .panel h3 {
    font-family: 'Bangers', sans-serif;
    font-size: 32px;
    letter-spacing: 2px;
    margin-bottom: 10px;
  }
  .panel p {
    font-weight: 600;
    color: #222;
  }
  /* ============================================
     PRICING
     ============================================ */
  #pricing { background: var(--paper); }
  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 28px;
    max-width: 1000px;
    margin: 0 auto;
  }
  .tier {
    position: relative;
    background: #fff;
    border: var(--border-w) solid var(--ink);
    box-shadow: 8px 8px 0 var(--ink);
    padding: 32px 24px 28px;
    text-align: center;
    transition: transform .15s, box-shadow .15s;
  }
  .tier:hover { transform: translate(-3px, -3px); box-shadow: 11px 11px 0 var(--ink); }
  .tier.featured {
    background: var(--yellow);
    transform: scale(1.04);
  }
  .tier.featured:hover { transform: scale(1.04) translate(-3px, -3px); }
  .tier-badge {
    position: absolute;
    top: -18px;
    left: 50%;
    transform: translateX(-50%) rotate(-3deg);
    background: var(--red);
    color: #fff;
    font-family: 'Bangers', sans-serif;
    font-size: 16px;
    letter-spacing: 2px;
    padding: 5px 14px;
    border: 3px solid var(--ink);
    white-space: nowrap;
  }
  .tier h3 {
    font-family: 'Bangers', sans-serif;
    font-size: 34px;
    letter-spacing: 2px;
    margin-bottom: 8px;
  }
  .tier .duration {
    font-weight: 800;
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: #555;
    margin-bottom: 18px;
  }
  .tier .price {
    font-family: 'Bangers', sans-serif;
    font-size: 72px;
    line-height: 1;
    color: var(--ink);
    margin-bottom: 4px;
  }
  .tier .price .dollar { font-size: 36px; vertical-align: top; }
  .tier .price-note {
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: #555;
    margin-bottom: 22px;
  }
  .tier ul {
    list-style: none;
    text-align: left;
    margin-bottom: 24px;
    padding: 0 6px;
  }
  .tier ul li {
    padding: 6px 0;
    font-weight: 600;
    font-size: 14px;
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }
  .tier ul li::before {
    content: "✓";
    font-weight: 900;
    color: var(--red);
    font-size: 18px;
    line-height: 1;
  }
  .buy-btn {
    display: block;
    width: 100%;
    background: var(--red);
    color: #fff;
    font-family: 'Bangers', sans-serif;
    font-size: 24px;
    letter-spacing: 2px;
    padding: 14px;
    border: 3px solid var(--ink);
    box-shadow: 5px 5px 0 var(--ink);
    text-decoration: none;
    cursor: pointer;
    transition: transform .1s, box-shadow .1s;
  }
  .buy-btn:hover { transform: translate(-2px,-2px); box-shadow: 7px 7px 0 var(--ink); }
  .tier.featured .buy-btn { background: var(--ink); }
  /* ============================================
     FOOTER
     ============================================ */
  footer {
    background: var(--ink);
    color: #eee;
    text-align: center;
    padding: 36px 24px;
    font-size: 13px;
  }
  footer .logo { font-size: 28px; margin-bottom: 8px; }
  footer .disclaimer {
    max-width: 600px;
    margin: 12px auto 0;
    font-size: 11px;
    color: #888;
    line-height: 1.6;
  }
</style>
</head>
<body>
<nav>
  <div class="nav-inner">
    <div class="logo">AFK-BOT</div>
    <div class="nav-links">
      <a href="#features">Features</a>
      <a href="#pricing">Pricing</a>
      <a href="#pricing" class="nav-cta">Buy Now</a>
    </div>
  </div>
</nav>
<main>
<!-- ============= HERO ============= -->
<section class="hero" style="padding:0;">
  <video autoplay muted loop playsinline>
    <source src="assets/hero.mp4" type="video/mp4">
  </video>
  <div class="hero-inner">
    <span class="tag">⚡ THE #1 ARENA BOT</span>
    <h1>AFK-BOT</h1>
